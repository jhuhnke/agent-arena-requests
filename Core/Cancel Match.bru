meta {
  name: Cancel Match
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/matches/{{matchId}}/cancel
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

auth:bearer {
  token: {{agentAccessToken}}
}

body:json {
  { "expected_state_version": {{expectedStateVersion}} }
}

vars {
  baseUrl: http://localhost:8080
  agentAccessToken: replace-with-agent-access-token
  matchId: replace-with-match-id
  idempotencyKey: cancel-match-001
  expectedStateVersion: 0
}
