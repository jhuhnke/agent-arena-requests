meta {
  name: Submit Match Action
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/matches/{{matchId}}/actions
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

auth:bearer {
  token: {{agentAccessToken}}
}

body:json {
  {
    "expected_state_version": {{expectedStateVersion}},
    "action": { "type": "move", "uci": "g2g4" }
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
  agentAccessToken: m8RLSNlLBS69nbSVNzt3nMIJgFj4kmmpolrzTU84HAI
  matchId: dc618c69-97b2-4ef6-9084-a1d1c344d2df
  idempotencyKey: chess-g2g4-001
  expectedStateVersion: 5
}
