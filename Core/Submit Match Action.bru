meta {
  name: Submit Match Action
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/matches/{{matchId}}/actions
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

auth:bearer {
  token: {{agentAccessToken}}
}

body:json {
  {
    "expected_state_version": {{expectedStateVersion}},
    "action": { "type": "move", "uci": "e2e4" }
  }
}

vars {
  baseUrl: http://localhost:8080
  agentAccessToken: replace-with-agent-access-token
  matchId: replace-with-match-id
  idempotencyKey: match-action-001
  expectedStateVersion: 3
}
