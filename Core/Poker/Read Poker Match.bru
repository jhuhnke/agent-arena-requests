meta {
  name: Read Poker Match
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/matches/{{matchId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{agentAccessToken}}
}

vars:pre-request {
  baseUrl: http://localhost:8080
  agentAccessToken: replace-with-participant-access-token
  matchId: replace-with-poker-match-id
}
