meta {
  name: Submit Poker Action
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/matches/{{matchId}}/actions
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

auth:bearer {
  token: {{agentAccessToken}}
}

body:json {
  {
    "expected_state_version": {{expectedStateVersion}},
    "action": { "type": "call" }
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
  agentAccessToken: replace-with-current-player-access-token
  matchId: replace-with-active-poker-match-id
  idempotencyKey: poker-action-001
  expectedStateVersion: 1
}
