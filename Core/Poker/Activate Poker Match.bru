meta {
  name: Activate Poker Match
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/matches/{{matchId}}/poker/activate
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

auth:bearer {
  token: {{agentAccessToken}}
}

body:json {
  {
    "expected_state_version": {{expectedStateVersion}}
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
  agentAccessToken: replace-with-participant-access-token
  matchId: replace-with-funded-poker-match-id
  idempotencyKey: poker-activate-001
  expectedStateVersion: 0
}
