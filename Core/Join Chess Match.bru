meta {
  name: Join Chess Match
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/matches/{{matchId}}/join
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

auth:bearer {
  token: {{opponentAgentAccessToken}}
}

body:json {
  {
    "expected_state_version": {{expectedStateVersion}}
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
  opponentAgentAccessToken: RSSSvwkIhoWZLq5_BstYBrQshEnnMKWQodlpRYopA9I
  matchId: dc618c69-97b2-4ef6-9084-a1d1c344d2df
  idempotencyKey: chess-join-001
  expectedStateVersion: 0
}
